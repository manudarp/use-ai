{
  "name": "use-ai",
  "version": "0.3.0",
  "description": "Provider-agnostic AI client with local SQLite Vector RAG for Node.js and Electron.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build"
  },
  "dependencies": {
    "@sqliteai/sqlite-vector": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "openai": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
